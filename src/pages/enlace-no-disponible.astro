---
/**
 * El 404 del portal, con la cara de Purifreze.
 *
 * No explica por qué —ni el cliente puede hacer nada con esa explicación, ni la
 * landing sabe realmente cuál de las causas fue—. Lo único que tiene que lograr
 * es que no parezca que algo se rompió, y dejar a mano el camino para seguir.
 *
 * Se llega por rewrite desde el middleware, así que conserva la URL con la que
 * el cliente entró.
 */
import { SEO_CONFIG } from '../config/seo.config';

const { whatsapp, phoneTel, phoneDisplay } = SEO_CONFIG.business.contact;

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Página no disponible · Purifreze</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="tarjeta">
      <img src="/assets/nombre-logo.png" alt="Purifreze" class="logo" />

      <h1>Esta página no está disponible</h1>

      <p>Escríbenos y te ayudamos a continuar.</p>

      <div class="acciones">
        <a class="boton-principal" href={whatsapp} rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path
              d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"
            />
            <path
              d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.33 4.94L2 22l5.35-1.4a9.83 9.83 0 0 0 4.69 1.2h.01c5.44 0 9.87-4.43 9.87-9.87 0-2.64-1.03-5.12-2.9-6.99A9.8 9.8 0 0 0 12.04 2zm0 18.06h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.16 8.16 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2a8.15 8.15 0 0 1 5.8 2.4 8.15 8.15 0 0 1 2.4 5.8c0 4.52-3.68 8.19-8.2 8.19z"
            />
          </svg>
          Escríbenos por WhatsApp
        </a>
        <a class="boton-secundario" href={`tel:${phoneTel}`}>{phoneDisplay}</a>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --pf-marino-profundo: #12275a;
    --pf-marino: #1a4c8b;
    --pf-tinta-media: #5b6675;
    --pf-borde: #dfe5ec;
    --pf-fondo: #f2f6fa;

    color-scheme: light;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--pf-fondo);
    color: var(--pf-tinta-media);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  .tarjeta {
    width: min(420px, 100%);
    background: #fff;
    border: 1px solid var(--pf-borde);
    border-radius: 14px;
    box-shadow: 0 24px 64px -16px rgba(18, 39, 90, 0.18);
    padding: 2.4rem 1.9rem;
    text-align: center;
  }

  .logo {
    height: 34px;
    width: auto;
    margin-bottom: 2rem;
  }

  h1 {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--pf-marino-profundo);
    margin: 0 0 0.6rem;
  }

  p {
    margin: 0;
    font-size: 0.97rem;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }

  /* 48px de alto: son para dedos que no atinan a un botón chico. */
  .boton-principal,
  .boton-secundario {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    border-radius: 9px;
    padding: 0.62rem 1.15rem;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .boton-principal {
    background: var(--pf-marino);
    color: #fff;
  }

  .boton-principal:hover {
    background: var(--pf-marino-profundo);
  }

  .boton-secundario {
    background: #fff;
    color: var(--pf-tinta-media);
    border-color: var(--pf-borde);
    font-variant-numeric: tabular-nums;
  }

  .boton-secundario:hover {
    background: var(--pf-fondo);
    border-color: #c8d2de;
  }
</style>
