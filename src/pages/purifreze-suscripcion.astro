---
/**
 * Portal del cliente: registro del método de pago.
 *
 * No arma la pantalla: entrega el index del portal Angular ya compilado, que
 * se genera con `npm run build:portal`. Ese script lo SACA de public/ a
 * propósito: los archivos de public/ los sirve el adaptador antes que el
 * middleware, así que un index ahí sería una segunda puerta a esta misma
 * pantalla. Los .js y .css sí quedan en public/ — sin el HTML no abren nada, y
 * el backend igual exige el token de sesión.
 *
 * Se importa como texto en tiempo de build (?raw) y no se lee del disco en cada
 * petición porque la ruta no es la misma en desarrollo que dentro del build.
 *
 * Esta página ya no inyecta nada: la sesión la abre /activar al canjear el
 * código y vive en el navegador. Si el portal no la encuentra, se vuelve solo.
 */
import indexDelPortal from '../../portal-index.html?raw';

return new Response(indexDelPortal, {
  status: 200,
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    // Lo que se ve acá son los datos de un cliente: que ningún intermediario
    // guarde la página.
    'Cache-Control': 'no-store, no-cache, must-revalidate',
    'X-Robots-Tag': 'noindex, nofollow',
  },
});
