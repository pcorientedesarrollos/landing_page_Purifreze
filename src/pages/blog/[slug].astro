---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import BlogBlocks from "../../components/BlogBlocks.astro";
import { fetchBlogPost, mediaUrl } from "../../lib/blog";
const slug = Astro.params.slug ?? "";
const result = await fetchBlogPost(slug);
if (!result) return Astro.redirect("/404", 302);
if (result.canonicalSlug !== slug) return Astro.redirect(`/blog/${result.canonicalSlug}`, 301);
const { post } = result;
const articleSchema = JSON.stringify({ "@context": "https://schema.org", "@type": "Article", headline: post.title, description: post.excerpt, image: mediaUrl(post.coverImageUrl), datePublished: post.publishedAt, dateModified: post.updatedAt, publisher: { "@type": "Organization", name: "Purifreze" } });
---
<Layout title={`${post.title} | Purifreze`} description={post.excerpt}>
  <script type="application/ld+json" set:html={articleSchema} slot="head" />
  <Navigation />
  <main class="min-h-screen bg-[#f8fbff] pb-24 pt-44">
    <article>
      <header class="mx-auto max-w-4xl px-6 text-center">
        <a href="/blog" class="text-xs font-black uppercase tracking-[.2em] text-blue-600">← Blog Purifreze</a>
        <h1 class="mt-6 text-4xl font-black leading-[1.05] tracking-tight text-slate-900 md:text-6xl">{post.title}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">{post.excerpt}</p>
      </header>
      {post.coverImageUrl && <img class="mx-auto mt-12 aspect-[16/8] w-[min(1120px,calc(100%-3rem))] rounded-[2rem] object-cover" src={mediaUrl(post.coverImageUrl)} alt="" />}
      <div class="mt-14 px-6"><BlogBlocks blocks={post.blocks} /></div>
    </article>
  </main>
  <Footer />
</Layout>
