---
import {
  COMPARISON_ROWS,
  DEFAULTS,
  LIMITS,
  PURIFREZE_PRICE_MONTHLY,
} from "../data/comparison";

const gastoInicial = DEFAULTS.garrafones * DEFAULTS.precio;
const ahorroInicial = gastoInicial - PURIFREZE_PRICE_MONTHLY;
const ahorroAnualInicial = ahorroInicial * 12;
---

<section class="comparison-section">
    <div class="container">
        <div class="section-header">
            <span class="badge">
                <i class="fa-solid fa-calculator"></i>
                Calculadora de Ahorro
            </span>
            <h2 class="title">
                ¿Cuánto <span class="gradient-text">ahorras con Purifreze?</span
                >
            </h2>
            <p class="subtitle">Descubre tu ahorro mensual</p>
        </div>

        <div class="calculator-container">
            <div class="calculator-card">
                <div class="input-section">
                    <div class="input-grid">
                        <div class="input-group">
                            <label class="input-label">
                                <i class="fa-solid fa-jug-detergent"></i>
                                ¿Cuántos garrafones usas al mes?
                            </label>
                            <div class="dual-input">
                                <div class="slider-container">
                                    <input
                                        type="range"
                                        id="garrafonesSlider"
                                        min={LIMITS.garrafones.min}
                                        max={LIMITS.garrafones.max}
                                        value={DEFAULTS.garrafones}
                                        class="slider"
                                    />
                                </div>
                                <div class="number-input-wrapper">
                                    <input
                                        type="number"
                                        id="garrafonesInput"
                                        min={LIMITS.garrafones.min}
                                        max={LIMITS.garrafones.max}
                                        value={DEFAULTS.garrafones}
                                        class="number-input"
                                    />
                                    <span class="input-suffix">garrafones</span>
                                </div>
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="input-label">
                                <i class="fa-solid fa-dollar-sign"></i>
                                ¿Cuánto cuesta cada garrafón?
                            </label>
                            <div class="dual-input">
                                <div class="number-input-wrapper price">
                                    <span class="input-prefix">$</span>
                                    <input
                                        type="number"
                                        id="precioInput"
                                        min={LIMITS.precio.min}
                                        max={LIMITS.precio.max}
                                        value={DEFAULTS.precio}
                                        step="1"
                                        class="number-input"
                                    />
                                    <span class="input-suffix">MXN</span>
                                </div>
                                <p class="input-hint">
                                    El precio promedio es ${DEFAULTS.precio}
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="monthly-spending">
                        <div class="spending-card">
                            <p class="spending-label">
                                Tu gasto actual en garrafones
                            </p>
                            <div class="spending-amount" id="gastoMensual">
                                ${gastoInicial}
                            </div>
                        </div>
                    </div>

                    <div class="calculation-grid">
                        <div class="cost-card garrafones-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-jug-detergent"></i>
                            </div>
                            <h3>Garrafones</h3>
                            <p class="cost-label">Costo Mensual</p>
                            <div class="cost-amount">
                                $<span id="garrafonesCost">{gastoInicial}</span>
                            </div>
                            <p class="cost-detail">
                                <span id="garrafonesQty">{DEFAULTS.garrafones}</span> garrafones al mes
                            </p>
                        </div>

                        <div class="vs-divider-vertical">
                            <span>VS</span>
                        </div>

                        <div class="cost-card purifreze-card">
                            <div class="card-icon purifreze">
                                <i class="fa-solid fa-droplet"></i>
                            </div>
                            <h3>Purifreze</h3>
                            <p class="cost-label">Costo Mensual</p>
                            <div class="cost-amount purifreze">
                                <span style="font-size: 0.6em;">Desde</span> ${PURIFREZE_PRICE_MONTHLY}
                            </div>
                        </div>
                        <p class="cost-detail">Suscripción Todo Incluido</p>
                    </div>
                </div>

                <div class="savings-section" id="savingsSection">
                    <div class="savings-card positive" id="savingsCard">
                        <div class="savings-icon">
                            <i class="fa-solid fa-piggy-bank"></i>
                        </div>
                        <div class="savings-content" id="savingsContent">
                            <p class="savings-label" id="savingsLabel">
                                ¡Tu ahorro mensual!
                            </p>

                            <div class="savings-amount" id="savingsAmount">
                                ${ahorroInicial}
                            </div>
                            <p class="savings-annual" id="savingsAnnual">
                                ${ahorroAnualInicial} al año
                            </p>

                            <ul class="premium-benefits-list">
                                <li>
                                    <i class="fa-solid fa-droplet"></i>
                                    Agua fresca recién filtrada (5 etapas)
                                </li>
                                <li>
                                    <i class="fa-solid fa-ban"></i>
                                    Libre de microplásticos y BPA
                                </li>
                                <li>
                                    <i class="fa-solid fa-hand-holding-heart"
                                    ></i>
                                    Sin cargar peso nunca más
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
    </div>

    <div class="comparison-table-section">
        <div class="table-header">
            <h3 class="table-title">
                <i class="fa-solid fa-chart-bar"></i>
                Comparación detallada
            </h3>

            <div class="category-filters">
                <button class="filter-btn active" data-category="all">
                    <i class="fa-solid fa-list"></i> Todas
                </button>
                <button class="filter-btn" data-category="cost">
                    <i class="fa-solid fa-dollar-sign"></i> Costo
                </button>
                <button class="filter-btn" data-category="convenience">
                    <i class="fa-solid fa-truck"></i> Conveniencia
                </button>
                <button class="filter-btn" data-category="quality">
                    <i class="fa-solid fa-award"></i> Calidad
                </button>
                <button class="filter-btn" data-category="health">
                    <i class="fa-solid fa-heart-pulse"></i> Salud
                </button>
                <button class="filter-btn" data-category="environment">
                    <i class="fa-solid fa-leaf"></i> Ecología
                </button>
            </div>
        </div>

        <div class="comparison-table-wrapper">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th class="feature-column">Característica</th>
                        <th class="purifreze-column">
                            <div class="column-header purifreze">
                                <i class="fa-solid fa-droplet"></i>
                                <span>Purifreze</span>
                            </div>
                        </th>
                        <th class="garrafon-column">
                            <div class="column-header garrafon">
                                <i class="fa-solid fa-jug-detergent"></i>
                                <span>Garrafones</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="comparisonRows">
                    {
                        COMPARISON_ROWS.map((row) => (
                            <tr class="table-row" data-category={row.category}>
                                <td class="feature-cell">
                                    <i
                                        class={`fa-solid ${row.featureIcon} category-icon`}
                                    />
                                    {row.feature}
                                </td>
                                <td class="value-cell purifreze">
                                    {row.purifrezeCheck && (
                                        <i class="fa-solid fa-check-circle check-icon" />
                                    )}
                                    <span class="value">{row.purifrezeText}</span>
                                    {row.purifrezeBadge && (
                                        <span
                                            class={`badge ${row.purifrezeBadge.variant}`}
                                        >
                                            {row.purifrezeBadge.text}
                                        </span>
                                    )}
                                </td>
                                <td class="value-cell garrafon">
                                    {row.garrafonesIcon && (
                                        <i
                                            class={`fa-solid ${row.garrafonesIcon} ${row.garrafonesIconClass}`}
                                        />
                                    )}
                                    <span
                                        class="value"
                                        id={row.garrafonesValueId}
                                    >
                                        {row.garrafonesText}
                                    </span>
                                    {row.garrafonesBadge && (
                                        <span
                                            class={`badge ${row.garrafonesBadge.variant}`}
                                        >
                                            {row.garrafonesBadge.text}
                                        </span>
                                    )}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>

    <style>
        /* Estilos Generales */
        .comparison-section {
            padding: 80px 20px;
            background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
            font-family: "Segoe UI", system-ui, sans-serif;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }
        .title {
            font-size: clamp(32px, 5vw, 48px);
            font-weight: 800;
            color: #1e293b;
            margin: 0 0 16px;
            line-height: 1.2;
        }
        .gradient-text {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .subtitle {
            font-size: 18px;
            color: #64748b;
            margin: 0;
        }

        /* Calculadora */
        .calculator-container {
            max-width: 900px;
            margin: 0 auto;
        }
        .calculator-card {
            background: white;
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
        }

        /* Inputs */
        .input-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            margin-bottom: 32px;
        }
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .input-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
        }
        .input-label i {
            color: #3b82f6;
        }

        .dual-input {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .slider {
            width: 100%;
            height: 8px;
            border-radius: 50px;
            background: #e2e8f0;
            outline: none;
            -webkit-appearance: none;
            cursor: pointer;
        }
        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #3b82f6;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(59, 130, 246, 0.4);
            transition: transform 0.2s;
        }
        .slider::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .number-input-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 16px;
            transition: border-color 0.3s;
        }
        .number-input-wrapper:focus-within {
            border-color: #3b82f6;
            background: white;
        }

        .number-input {
            border: none;
            background: transparent;
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
            width: 60px;
            text-align: center;
            outline: none;
        }
        .input-hint {
            font-size: 12px;
            color: #94a3b8;
            font-style: italic;
            margin-top: -8px;
        }

        /* Gasto Mensual Box */
        .monthly-spending {
            margin-top: 20px;
        }
        .spending-card {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 20px;
            padding: 24px;
            text-align: center;
        }
        .spending-label {
            font-size: 13px;
            font-weight: 700;
            color: #1e40af;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }
        .spending-amount {
            font-size: 40px;
            font-weight: 900;
            color: #2563eb;
            line-height: 1;
            transition: transform 0.2s;
        }
        .spending-amount.updating {
            transform: scale(1.1);
        }

        /* Calculation Grid */
        .calculation-grid {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 24px;
            margin-bottom: 40px;
            align-items: stretch;
        }
        .cost-card {
            background: #f8fafc;
            border-radius: 24px;
            padding: 24px;
            text-align: center;
            border: 2px solid #e2e8f0;
        }
        .cost-card.purifreze-card {
            background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
            border-color: #bfdbfe;
        }
        .card-icon {
            width: 50px;
            height: 50px;
            margin: 0 auto 16px;
            background: #e2e8f0;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #64748b;
        }
        .card-icon.purifreze {
            background: #3b82f6;
            color: white;
        }
        .cost-card h3 {
            margin: 0 0 8px;
            color: #1e293b;
            font-size: 18px;
        }
        .cost-label {
            font-size: 12px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 600;
            margin: 0 0 10px;
        }
        .cost-amount {
            font-size: 32px;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 8px;
        }
        .cost-amount.purifreze {
            color: #3b82f6;
        }
        .cost-detail {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }

        .vs-divider-vertical {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .vs-divider-vertical span {
            background: #3b82f6;
            color: white;
            font-weight: 900;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            box-shadow: 0 4px 10px rgba(59, 130, 246, 0.4);
        }

        /* Savings Section - ESTILOS ACTUALIZADOS */
        .savings-section {
            margin-bottom: 32px;
        }

        .savings-card {
            border-radius: 20px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 0.3s;
        }

        /* --- ESTILO POSITIVO (Ahorro / Verde) --- */
        .savings-card.positive {
            background: #dcfce7;
            border: 2px solid #22c55e;
        }
        .savings-card.positive .savings-icon {
            background: #22c55e;
            color: white;
        }
        .savings-card.positive .savings-label {
            color: #15803d;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .savings-card.positive .savings-amount {
            color: #16a34a;
            font-size: 36px;
            font-weight: 900;
            display: block;
        }
        .savings-card.positive .savings-annual {
            color: #15803d;
            font-size: 14px;
            font-weight: 600;
            display: block;
        }
        /* Ocultamos la lista en modo verde */
        .savings-card.positive .premium-benefits-list {
            display: none;
        }

        /* --- ESTILO PREMIUM (Más costo / Morado) --- */
        .savings-card.premium {
            background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%);
            border: 2px solid #a855f7;
        }
        .savings-card.premium .savings-icon {
            background: #a855f7;
            color: white;
        }
        .savings-card.premium .savings-label {
            color: #6b21a8;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 12px;
            line-height: 1.4;
            text-transform: none;
        }

        /* Ocultamos precios grandes en modo morado */
        .savings-card.premium .savings-amount,
        .savings-card.premium .savings-annual {
            display: none;
        }

        /* Mostramos la lista en modo morado */
        .savings-card.premium .premium-benefits-list {
            display: block;
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .premium-benefits-list li {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #581c87;
            margin-bottom: 6px;
            font-weight: 600;
        }
        .premium-benefits-list li i {
            color: #a855f7;
        }
        .premium-benefits-list li:last-child {
            margin-bottom: 0;
        }

        /* Icono General */
        .savings-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex-shrink: 0;
        }

        /* CTA */
        .cta-section {
            text-align: center;
        }
        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 32px;
            background: linear-gradient(135deg, #25d366 0%, #16a34a 100%);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 18px;
            transition:
                transform 0.2s,
                box-shadow 0.2s;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
        }
        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.5);
        }

        /* Table Styles */
        .comparison-table-section {
            max-width: 900px;
            margin: 60px auto 0;
            background: white;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        }
        .table-title {
            font-size: 2.5rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 24px;
            color: #1e293b;
        }
        .category-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: center;
            margin-top: 20px;
        }
        .filter-btn {
            border: 1px solid #e2e8f0;
            background: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .filter-btn:hover,
        .filter-btn.active {
            background: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .comparison-table th {
            text-align: left;
            padding: 16px;
            border-bottom: 2px solid #e2e8f0;
            color: #475569;
        }
        .column-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
        }
        .column-header.purifreze {
            color: #3b82f6;
        }
        .column-header.garrafon {
            color: #64748b;
        }
        .table-row {
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.2s;
        }
        .table-row:hover {
            background: #f8fafc;
        }
        .table-row.hidden {
            display: none;
        }
        .comparison-table td {
            padding: 16px;
            vertical-align: middle;
        }
        .feature-cell {
            font-weight: 600;
            color: #475569;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .category-icon {
            color: #3b82f6;
            width: 20px;
            text-align: center;
        }
        .value-cell .value {
            display: block;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 4px;
        }
        .check-icon {
            color: #22c55e;
            margin-right: 6px;
        }
        .cross-icon {
            color: #ef4444;
            margin-right: 6px;
        }
        .neutral-icon {
            color: #f59e0b;
            margin-right: 6px;
        }
        .badge.success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
            padding: 2px 8px;
            font-size: 11px;
        }
        .badge.warning {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fcd34d;
            padding: 2px 8px;
            font-size: 11px;
        }

        @media (max-width: 768px) {
            .input-grid {
                grid-template-columns: 1fr;
            }
            .calculation-grid {
                grid-template-columns: 1fr;
            }
            .savings-card {
                flex-direction: column;
                text-align: center;
            }
            .premium-benefits-list li {
                justify-content: center;
            }
        }
    </style>

    <style is:global>
        .comparison-table .table-row {
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.2s;
        }

        .comparison-table .table-row:hover {
            background: #f8fafc;
        }

        .comparison-table .table-row.hidden {
            display: none;
        }

        .comparison-table td {
            padding: 16px;
            vertical-align: middle;
        }

        .comparison-table .feature-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #475569;
            font-weight: 600;
        }

        .comparison-table .category-icon {
            width: 20px;
            color: #3b82f6;
            text-align: center;
        }

        .comparison-table .value-cell .value {
            display: block;
            color: #1e293b;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .comparison-table .check-icon {
            color: #22c55e;
            margin-right: 6px;
        }

        .comparison-table .cross-icon {
            color: #ef4444;
            margin-right: 6px;
        }

        .comparison-table .neutral-icon {
            color: #f59e0b;
            margin-right: 6px;
        }

        .comparison-table .warning-icon {
            color: #f59e0b;
            margin-right: 6px;
        }

        .comparison-table .badge.success,
        .comparison-table .badge.warning {
            display: inline-flex;
