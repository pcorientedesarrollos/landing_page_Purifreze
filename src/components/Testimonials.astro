---
// Enhanced testimonials section with premium video design
const testimonials = [
  {
    video: "/assets/testimonio2.mp4",
    label: "Dueña de Maracuyá",
    name: "MARIA DOLORES LICEA SOLIS",
  },
  {
    video: "/assets/testimonio.mp4",
    label: "Dueña de Benélica Cafetería-Wellness & Coffee",
    name: "LEYLA FERNANDA CHAVEZ DEL PINO",
    featured: true,
  },
  {
    video: "/assets/testimonio3.mp4",
    label: "Dueño de casa Flauta",
    name: "ERICK HERNANDEZ",
  },
];
---

<section
  id="testimonialsSection"
  class="py-24 bg-gradient-to-br from-blue-50 via-slate-50 to-cyan-50 relative overflow-hidden"
>
  <div
    class="absolute top-10 left-10 w-72 h-72 bg-blue-200 rounded-full blur-3xl opacity-20"
  >
  </div>
  <div
    class="absolute bottom-10 right-10 w-96 h-96 bg-cyan-200 rounded-full blur-3xl opacity-20"
  >
  </div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 mb-4 px-4 py-2 bg-gradient-to-r from-blue-100 to-cyan-100 rounded-full"
      >
        <i class="fa-solid fa-quote-left text-blue-600"></i>
        <span class="text-xs font-bold uppercase tracking-widest text-blue-700">
          Testimonios
        </span>
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Familias y empresas en Mérida que confían en Purifreze
      </p>
    </div>

    <div class="testimonials-carousel">
      <button id="testimonialsPrevious" class="testimonials-carousel-button previous" type="button" aria-label="Testimonio anterior"><i class="fa-solid fa-chevron-left"></i></button>
      <div id="testimonialsGrid" class="testimonials-track">
      {
        testimonials.map((testimonial) => (
          <div
            class={`group relative ${testimonial.featured ? "md:-translate-y-6" : ""}`}
          >
            <div
              class={`${
                testimonial.featured
                  ? "bg-gradient-to-br from-blue-600 via-blue-500 to-cyan-500 shadow-2xl shadow-blue-500/30"
                  : "bg-white shadow-xl shadow-slate-200"
              } rounded-[2rem] overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl ${
                testimonial.featured
                  ? "hover:shadow-blue-500/40"
                  : "hover:shadow-slate-300"
              }`}
            >
              <div class="relative aspect-[9/16] overflow-hidden bg-slate-900">
                <video
                  src={testimonial.video}
                  class="absolute inset-0 w-full h-full object-cover"
                  controls
                  preload="metadata"
                >
                  Tu navegador no soporta videos HTML5.
                </video>

                <div
                  class={`absolute inset-0 bg-gradient-to-t ${
                    testimonial.featured
                      ? "from-blue-900/60 via-transparent to-transparent"
                      : "from-slate-900/60 via-transparent to-transparent"
                  } pointer-events-none z-10`}
                />
              </div>

              <div class="p-6 relative z-20">
                <div class="flex items-center gap-3 mb-2">
                  <div
                    class={`w-10 h-10 rounded-full ${
                      testimonial.featured ? "bg-white/20" : "bg-blue-100"
                    } flex items-center justify-center`}
                  >
                    <i
                      class={`fa-solid fa-user ${
                        testimonial.featured ? "text-white" : "text-blue-600"
                      }`}
                    />
                  </div>
                  <div>
                    <p
                      class={`font-bold leading-tight ${
                        testimonial.featured ? "text-white" : "text-slate-800"
                      }`}
                    >
                      {testimonial.name}
                    </p>
                    <p
                      class={`text-xs font-semibold uppercase tracking-wider mt-1 ${
                        testimonial.featured
                          ? "text-white/80"
                          : "text-slate-500"
                      }`}
                    >
                      {testimonial.label}
                    </p>
                  </div>
                </div>

                <div class="flex gap-1 mt-3">
                  {[...Array(5)].map((_, i) => (
                    <i
                      class={`fa-solid fa-star text-sm ${
                        testimonial.featured
                          ? "text-yellow-300"
                          : "text-yellow-500"
                      }`}
                    />
                  ))}
                </div>
              </div>
            </div>

            {testimonial.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-full shadow-lg z-30">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-crown text-white text-xs" />
                  <span class="text-xs font-black text-white uppercase tracking-wider">
                    Destacado
                  </span>
                </div>
              </div>
            )}
          </div>
        ))
      }
      </div>
      <button id="testimonialsNext" class="testimonials-carousel-button next" type="button" aria-label="Siguiente testimonio"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
    <div id="testimonialsDots" class="testimonials-dots" aria-label="Navegación de testimonios"></div>

    <div class="text-center mt-16">
      <a
        href="https://wa.me/5219991336108"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-8 py-4 rounded-full font-bold text-lg shadow-xl shadow-blue-500/30 hover:shadow-2xl hover:shadow-blue-500/40 transition-all transform hover:scale-105"
      >
        <i class="fa-brands fa-whatsapp text-2xl"></i>
        <span>Únete a Nuestros Clientes Satisfechos</span>
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<style is:global>
  #testimonialsSection[hidden] { display: none; }
  .testimonial-card { background: white; box-shadow: 0 20px 25px -5px rgb(226 232 240); }
  .testimonial-card.featured { background: linear-gradient(135deg, #2563eb, #3b82f6, #06b6d4); box-shadow: 0 25px 50px -12px rgb(59 130 246 / .3); }
  .testimonial-overlay { --tw-gradient-from: rgb(15 23 42 / .6); }
  .testimonial-card.featured .testimonial-overlay { --tw-gradient-from: rgb(30 58 138 / .6); }
  .testimonial-avatar { background: #dbeafe; }
  .testimonial-card.featured .testimonial-avatar { background: rgb(255 255 255 / .2); }
  .testimonial-avatar i { color: #2563eb; }
  .testimonial-card.featured .testimonial-avatar i, .testimonial-card.featured .testimonial-name { color: white; }
  .testimonial-name { color: #1e293b; }
  .testimonial-label { color: #64748b; }
  .testimonial-card.featured .testimonial-label { color: rgb(255 255 255 / .8); }
  .testimonial-star { color: #eab308; }
  .testimonial-card.featured .testimonial-star { color: #fde047; }
  .testimonials-carousel { position: relative; }
  .testimonials-track { display: flex; gap: 2rem; overflow-x: auto; padding: 1.5rem .25rem 2rem; scroll-behavior: smooth; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .testimonials-track::-webkit-scrollbar { display: none; }
  .testimonials-track > * { flex: 0 0 100%; scroll-snap-align: start; }
  .testimonials-carousel-button { position: absolute; top: 44%; z-index: 35; display: grid; width: 3rem; height: 3rem; border: 1px solid #bfdbfe; border-radius: 50%; background: #ffffffee; color: #1d4ed8; place-items: center; transform: translateY(-50%); box-shadow: 0 10px 24px rgb(30 64 175 / 18%); }
  .testimonials-carousel-button.previous { left: -.75rem; }
  .testimonials-carousel-button.next { right: -.75rem; }
  .testimonials-carousel-button[hidden] { display: none; }
  .testimonials-dots { display: flex; justify-content: center; gap: .5rem; margin-top: .25rem; }
  .testimonials-dot { width: .55rem; height: .55rem; border-radius: 999px; background: #bfdbfe; transition: width .2s ease, background-color .2s ease; }
  .testimonials-dot.active { width: 1.75rem; background: #2563eb; }
  @media (min-width: 768px) {
    .testimonials-track > * { flex-basis: calc((100% - 4rem) / 3); }
    .testimonials-carousel-button.previous { left: -1.5rem; }
    .testimonials-carousel-button.next { right: -1.5rem; }
  }
</style>

<script>
  import { initTestimonialsSection } from "../scripts/testimonials-section";
  document.addEventListener("DOMContentLoaded", initTestimonialsSection);
  document.addEventListener("astro:page-load", initTestimonialsSection);
</script>
