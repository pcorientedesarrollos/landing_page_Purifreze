---
interface Props {
  title: string;
  videoSrc: string;
  vertical?: boolean;
  subtitle?: string;
}

const { title, videoSrc, vertical = true, subtitle } = Astro.props;
---

<section class="video-gallery-section">
  <div class="video-decoration video-decoration-top"></div>
  <div class="video-decoration video-decoration-bottom"></div>

  <div class="video-gallery-shell">
    <header class="video-gallery-header">
      <div class="video-eyebrow">
        <i class="fa-solid fa-video"></i>
        <span>Videos</span>
      </div>
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </header>

    <div class="video-carousel">
      <button class="video-carousel-button previous" id="videoCarouselPrevious" type="button" aria-label="Video anterior">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <div class="video-gallery-grid" id="videoGalleryGrid">
        <article class={`video-card ${vertical ? "vertical" : "horizontal"}`}>
          <div class="video-card-copy">
            <i class="fa-solid fa-circle-play"></i>
            <span>Video informativo</span>
          </div>
          <div class="video-frame">
            <video controls playsinline preload="metadata">
              <source src={videoSrc} type="video/mp4" />
              Tu navegador no soporta video HTML5.
            </video>
          </div>
        </article>
      </div>
      <button class="video-carousel-button next" id="videoCarouselNext" type="button" aria-label="Siguiente video">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
    <div class="video-carousel-dots" id="videoCarouselDots" aria-label="Navegación de videos"></div>
  </div>
</section>

<style is:global>
  .video-gallery-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f8fafc 0%, #ffffff 50%, #eff6ff 100%);
    padding: 96px 24px;
  }

  .video-gallery-section[hidden] {
    display: none;
  }

  .video-decoration {
    position: absolute;
    width: 384px;
    height: 384px;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.3;
    pointer-events: none;
  }

  .video-decoration-top {
    top: -192px;
    right: -192px;
    background: #dbeafe;
  }

  .video-decoration-bottom {
    bottom: -192px;
    left: -192px;
    background: #cffafe;
  }

  .video-gallery-shell {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .video-gallery-header {
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .video-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    text-transform: uppercase;
  }

  .video-gallery-header h2 {
    color: #0f172a;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.08;
    margin: 16px 0 0;
  }

  .video-gallery-header p {
    color: #64748b;
    font-size: 18px;
    line-height: 1.6;
    margin: 16px auto 0;
  }

  .video-gallery-grid {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    padding: 1.5rem .25rem 2rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .video-gallery-grid::-webkit-scrollbar {
    display: none;
  }

  .video-carousel {
    position: relative;
    margin: 0 auto;
  }

  .video-card {
    position: relative;
    flex: 0 0 100%;
    overflow: hidden;
    border: 1px solid #dbeafe;
    border-radius: 26px;
    background: #ffffff;
    box-shadow: 0 18px 42px rgb(30 64 175 / 12%);
    scroll-snap-align: start;
    transition: box-shadow .25s ease, transform .25s ease;
  }

  .video-card:hover {
    box-shadow: 0 24px 48px rgb(30 64 175 / 18%);
    transform: translateY(-4px);
  }

  .video-carousel-button {
    position: absolute;
    top: 44%;
    z-index: 3;
    display: grid;
    width: 48px;
    height: 48px;
    border: 1px solid #bfdbfe;
    border-radius: 50%;
    background: #ffffffee;
    color: #1d4ed8;
    place-items: center;
    transform: translateY(-50%);
    box-shadow: 0 10px 24px rgb(30 64 175 / 18%);
  }

  .video-carousel-button.previous { left: -.75rem; }
  .video-carousel-button.next { right: -.75rem; }
  .video-carousel-button[hidden] { display: none; }

  .video-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
  }

  .video-carousel-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #bfdbfe;
    transition: width .2s ease, background-color .2s ease;
  }

  .video-carousel-dot.active {
    width: 28px;
    background: #2563eb;
  }

  .video-frame {
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #0f172a;
  }

  .video-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card-copy {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #475569;
    font-size: 14px;
    font-weight: 700;
    padding: 15px 17px 16px;
  }

  .video-card-copy i {
    color: #2563eb;
  }

  @media (max-width: 640px) {
    .video-gallery-section {
      padding: 72px 18px;
    }

    .video-gallery-header {
      margin-bottom: 32px;
    }

    .video-carousel-button {
      width: 42px;
      height: 42px;
    }

    .video-carousel-button.previous { left: -12px; }
    .video-carousel-button.next { right: -12px; }
  }

  @media (min-width: 768px) {
    .video-card {
      flex-basis: calc((100% - 4rem) / 3);
    }

    .video-carousel-button.previous { left: -1.5rem; }
    .video-carousel-button.next { right: -1.5rem; }
  }
</style>

<script>
  import { initVideoSection } from "../scripts/video-section";

  document.addEventListener("DOMContentLoaded", initVideoSection);
  document.addEventListener("astro:page-load", initVideoSection);
</script>
