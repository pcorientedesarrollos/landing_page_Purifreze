---
import { fetchUseCards, getApiUrl, resolveUploadUrl, type ApiUseCard } from "../scripts/cms";

const fallbackUseCards: ApiUseCard[] = [
  {
    id: -1,
    type: "text",
    title: "Uso residencial",
    description: "Perfecta para hogares en Merida, Yucatan que buscan agua de la mas alta calidad sin complicaciones.",
    icon: "fa-home",
    mediaUrl: null,
    altText: null,
    isVisible: true,
    sortOrder: 0,
  },
  {
    id: -2,
    type: "text",
    title: "Uso comercial",
    description: "Ideal para oficinas, gimnasios, restaurantes y negocios que requieren agua pura constantemente.",
    icon: "fa-building",
    mediaUrl: null,
    altText: null,
    isVisible: true,
    sortOrder: 1,
  },
  {
    id: -3,
    type: "image",
    title: "Sistema de purificacion profesional",
    description: "Dispensador Purifreze para hogares y negocios.",
    icon: null,
    mediaUrl: "/assets/maquina-dispensadora2.png",
    altText: "Dispensador de agua Purifreze - Sistema de purificacion moderno",
    isVisible: true,
    sortOrder: 2,
  },
  {
    id: -4,
    type: "video",
    title: "Instalacion Parte 1",
    description: "Proceso de instalacion del purificador.",
    icon: "fa-tools",
    mediaUrl: "/assets/instalacion.mp4",
    altText: null,
    isVisible: true,
    sortOrder: 3,
  },
  {
    id: -5,
    type: "video",
    title: "Instalacion Parte 2",
    description: "Uso del sistema Purifreze en casa.",
    icon: "fa-wrench",
    mediaUrl: "/assets/instalacion2.mp4",
    altText: null,
    isVisible: true,
    sortOrder: 4,
  },
];

const apiUrl = getApiUrl();
const dynamicCards = (await fetchUseCards()).filter((card) => card.isVisible !== false);
const useCards = dynamicCards.length > 0 ? dynamicCards : fallbackUseCards;

function mediaUrl(card: ApiUseCard): string {
  return card.mediaUrl ? resolveUploadUrl(card.mediaUrl, apiUrl) : "";
}

function iconFor(card: ApiUseCard): string {
  return card.icon || (card.type === "text" ? "fa-droplet" : card.type === "video" ? "fa-play" : "fa-image");
}
---

<section class="uses-section">
  <div class="uses-shell">
    <div class="uses-header">
      <div class="uses-kicker">
        <i class="fa-solid fa-grid-2"></i>
        <span>Aplicaciones</span>
      </div>
      <h2>Usos del purificador de agua</h2>
      <p>Versatilidad para cada necesidad: hogares, oficinas y negocios</p>
    </div>

    <div class="uses-grid">
      {useCards.map((card) => (
        <article class={`use-card use-card-${card.type}`}>
          <div class="use-card-media">
            {card.type === "video" && card.mediaUrl && (
              <video controls playsinline preload="metadata">
                <source src={mediaUrl(card)} type="video/mp4" />
                Tu navegador no soporta video HTML5.
              </video>
            )}
            {card.type === "image" && card.mediaUrl && (
              <img src={mediaUrl(card)} alt={card.altText || card.title} loading="lazy" />
            )}
            {card.type === "text" && (
              <div class="use-card-icon">
                <i class={`fa-solid ${iconFor(card)}`}></i>
              </div>
            )}
          </div>

          <div class="use-card-copy">
            <div class="use-card-label">
              <i class={`fa-solid ${iconFor(card)}`}></i>
              <span>{card.type === "video" ? "Video" : card.type === "image" ? "Imagen" : "Uso"}</span>
            </div>
            <h3>{card.title}</h3>
            {card.description && <p>{card.description}</p>}
          </div>
        </article>
      ))}
    </div>

    <div class="uses-action">
      <a
        href="https://wa.me/5219991336108?text=Hola,%20quiero%20información%20sobre%20el%20purificador%20de%20agua"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-brands fa-whatsapp"></i>
        <span>Solicita una demostración</span>
        <i class="fa-solid fa-arrow-right"></i>
      </a>
      <p>Instalación profesional • Sin costo inicial</p>
    </div>
  </div>
</section>

<style>
  .uses-section {
    background: #ffffff;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .uses-shell {
    margin: 0 auto;
    max-width: 1200px;
    padding: 0 1.5rem;
  }

  .uses-header {
    margin: 0 auto 3.5rem;
    max-width: 720px;
    text-align: center;
  }

  .uses-kicker {
    align-items: center;
    background: #dff7ff;
    border-radius: 999px;
    color: #1d66d8;
    display: inline-flex;
    font-size: .72rem;
    font-weight: 800;
    gap: .5rem;
    margin-bottom: 1rem;
    padding: .45rem .9rem;
    text-transform: uppercase;
  }

  .uses-header h2 {
    color: #071c3c;
    font-size: clamp(2rem, 4vw, 3.15rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .uses-header p {
    color: #52647a;
    font-size: 1rem;
    line-height: 1.6;
    margin: 1rem 0 0;
  }

  .uses-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .use-card {
    background: #f7fbff;
    border: 1px solid #c9e8fb;
    border-radius: 8px;
    display: grid;
    grid-template-rows: minmax(190px, 1fr) auto;
    min-height: 360px;
    overflow: hidden;
  }

  .use-card-media {
    background: linear-gradient(135deg, #e7f7ff, #f5fcff);
    display: grid;
    min-height: 190px;
    place-items: center;
  }

  .use-card-media img,
  .use-card-media video {
    height: 100%;
    max-height: 280px;
    object-fit: contain;
    width: 100%;
  }

  .use-card-video .use-card-media {
    background: #0a1630;
  }

  .use-card-video .use-card-media video {
    object-fit: cover;
  }

  .use-card-icon {
    align-items: center;
    background: #2367f0;
    border-radius: 8px;
    color: #ffffff;
    display: flex;
    font-size: 2rem;
    height: 5rem;
    justify-content: center;
    width: 5rem;
  }

  .use-card-copy {
    background: #ffffff;
    display: grid;
    gap: .65rem;
    padding: 1.2rem;
  }

  .use-card-label {
    align-items: center;
    color: #2470e8;
    display: flex;
    font-size: .7rem;
    font-weight: 900;
    gap: .45rem;
    text-transform: uppercase;
  }

  .use-card-copy h3 {
    color: #08265a;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .use-card-copy p {
    color: #42566f;
    font-size: .92rem;
    line-height: 1.55;
    margin: 0;
  }

  .uses-action {
    margin-top: 3rem;
    text-align: center;
  }

  .uses-action a {
    align-items: center;
    background: #14b8d4;
    border-radius: 999px;
    box-shadow: 0 18px 38px rgba(20, 184, 212, .25);
    color: #ffffff;
    display: inline-flex;
    font-size: 1rem;
    font-weight: 900;
    gap: .75rem;
    padding: 1rem 1.5rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .uses-action p {
    color: #64748b;
    font-size: .9rem;
    margin: .9rem 0 0;
  }

  @media (max-width: 640px) {
    .use-card {
      min-height: 320px;
    }

    .uses-action a {
      justify-content: center;
      width: 100%;
    }
  }
</style>
