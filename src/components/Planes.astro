---
import { SEO_CONFIG } from "../config/seo.config";

const { whatsapp, email, phoneTel, phoneDisplay, address } = SEO_CONFIG.business.contact;

const planes = [
  {
    nombre: "Básico",
    precio: 370,
    para: "Para una casa o una oficina chica",
    incluye: [
      "Ósmosis inversa de 5 etapas",
      "Filtro de sedimentos, carbón bloque y carbón granular",
      "Membrana de 100 galones por día",
      "Post-filtro de carbón para el sabor",
    ],
    destacado: false,
  },
  {
    nombre: "Robusto",
    precio: 500,
    para: "Para familias grandes o consumo alto",
    incluye: [
      "Todo lo del plan Básico",
      "Tanque de mayor capacidad: más agua lista al mismo tiempo",
      "Recuperación más rápida entre servicios",
    ],
    destacado: true,
  },
  {
    nombre: "Security Plus",
    precio: 549,
    para: "Para negocios y quien quiere la máxima protección",
    incluye: [
      "Todo lo del plan Robusto",
      "Lámpara ultravioleta de 12W contra bacterias y virus",
      "Es el equipo que más contratan nuestros clientes",
    ],
    destacado: false,
  },
];

const comunes = [
  { icono: "fa-solid fa-wrench", texto: "Instalación gratis" },
  { icono: "fa-solid fa-wallet", texto: "$0 de inversión inicial" },
  { icono: "fa-solid fa-screwdriver-wrench", texto: "Mantenimiento y filtros incluidos" },
  { icono: "fa-solid fa-droplet", texto: "Agua purificada ilimitada" },
];
---

<!-- pt chico: la banda del cliente que ya renta es lo primero de la página y el
     <main> de /planes ya reserva el alto de la barra fija. Con py-16 quedaba un
     hueco blanco antes de ella. -->
<section class="max-w-[1200px] mx-auto px-6 pt-4 pb-16">
  <!-- Arriba y no al final: es lo primero que el cliente que YA renta necesita
       de esta página, y antes vivía debajo de los tres planes y del CTA de
       venta, así que sólo lo encontraba quien bajaba hasta el borde. Sigue
       separado de la oferta —banda propia, color propio, antes de que empiece
       el catálogo— para que el visitante nuevo no crea que tiene que registrar
       una tarjeta para contratar. -->
  <div
    class="mb-14 flex flex-col gap-6 rounded-2xl border border-blue-100 bg-gradient-to-r from-blue-50 to-cyan-50 p-6 sm:p-8 md:flex-row md:items-center md:justify-between md:gap-10"
  >
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-blue-700">
        ¿Ya eres cliente?
      </p>
      <p class="mt-2 max-w-md text-slate-700">
        Registra tu tarjeta una vez y tu renta se paga sola cada mes. Sin
        transferencias, sin recordatorios.
      </p>

      <!-- El logo va junto al texto y no dentro del botón: quien duda antes de
           dar su tarjeta busca de quién es la pasarela, no una marca más en el
           botón. -->
      <p class="mt-4 flex items-center gap-2 text-sm font-medium text-slate-600">
        <span>Pagos procesados por</span>
        <img
          src="/assets/openpay-bbva.jpg"
          alt="Openpay by BBVA"
          width="96"
          height="36"
          class="h-7 w-auto"
        />
      </p>
    </div>

    <a
      href="/activar"
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-white px-7 py-4 text-base font-bold text-blue-700 shadow-sm ring-2 ring-blue-600 transition hover:-translate-y-0.5 hover:bg-blue-600 hover:text-white hover:shadow-lg hover:shadow-blue-500/30"
    >
      <i class="fa-regular fa-credit-card text-xl"></i>
      Automatiza tus cobros
    </a>
  </div>

  <div class="text-center max-w-2xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-black text-slate-900">
      Planes de renta
    </h2>
    <p class="mt-4 text-lg text-slate-600">
      Renta mensual, sin comprar el equipo. Los tres incluyen instalación,
      mantenimiento y los cambios de filtro.
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {planes.map((plan) => (
      <article
        class={`relative flex flex-col rounded-2xl border bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg ${
          plan.destacado
            ? "border-blue-500 shadow-blue-500/10 ring-1 ring-blue-500"
            : "border-slate-200"
        }`}
      >
        {plan.destacado && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-1 text-[11px] font-black uppercase tracking-wide text-white shadow">
            El más pedido
          </span>
        )}

        <h3 class="text-xl font-black text-slate-900">{plan.nombre}</h3>
        <p class="mt-1 text-sm text-slate-500">{plan.para}</p>

        <p class="mt-6 flex items-baseline gap-1">
          <span class="text-4xl font-black text-slate-900">
            ${plan.precio.toLocaleString("es-MX")}
          </span>
          <span class="text-sm font-semibold text-slate-500">al mes</span>
        </p>
        <p class="text-xs text-slate-500">IVA incluido</p>

        <ul class="mt-6 space-y-3 text-sm text-slate-700">
          {plan.incluye.map((linea) => (
            <li class="flex gap-3">
              <i class="fa-solid fa-check mt-1 text-blue-600"></i>
              <span>{linea}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <div class="mt-12 rounded-2xl bg-slate-50 px-6 py-8">
    <p class="text-center text-sm font-bold uppercase tracking-wide text-slate-500">
      Los tres planes incluyen
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {comunes.map((item) => (
        <div class="flex items-center gap-3">
          <i class={`${item.icono} text-xl text-blue-600`}></i>
          <span class="text-sm font-semibold text-slate-700">{item.texto}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-10 text-center">
    <p class="text-slate-600">
      ¿No sabes cuál te conviene? Te ayudamos a elegir según cuánta agua
      consumen al día.
    </p>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-blue-600 to-cyan-500 px-7 py-4 text-base font-bold text-white shadow-lg shadow-blue-500/30 transition hover:-translate-y-0.5 hover:shadow-blue-500/50"
    >
      <i class="fa-brands fa-whatsapp text-xl"></i>
      Pregúntanos por WhatsApp
    </a>
  </div>

  <!-- Identidad del comercio junto al CTA de pago: quien está por registrar
       su tarjeta arriba necesita poder verificar a quién se la está dando. -->
  <div class="mt-10 flex flex-col items-center gap-2 text-center text-sm text-slate-500">
    <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
      <a href={`mailto:${email}`} class="hover:text-blue-700 hover:underline">
        <i class="fa-solid fa-envelope mr-1.5 text-blue-600"></i>{email}
      </a>
      <span class="text-slate-300">·</span>
      <a href={`tel:${phoneTel}`} class="hover:text-blue-700 hover:underline">
        <i class="fa-solid fa-phone mr-1.5 text-blue-600"></i>{phoneDisplay}
      </a>
    </p>
    <p class="max-w-md">
      <i class="fa-solid fa-location-dot mr-1.5 text-blue-600"></i>
      Purifreze, S. de R.L. de C.V. — {address.streetAddress}, {address.addressLocality},
      {address.addressRegion}, C.P. {address.postalCode}
    </p>
  </div>
</section>
